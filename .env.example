# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Only the publishable/anon key belongs here. Never the service_role key:
# NEXT_PUBLIC_ values are compiled into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (no NEXT_PUBLIC_ prefix). See BOOKING-DELIVERY-SETUP.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_EMAIL_REPLY_TO=
